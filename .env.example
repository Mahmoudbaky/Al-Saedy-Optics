# Backend base URL (no trailing slash). Copy to .env.local (gitignored).
# Leave empty in development to use the Metro host automatically
# (your machine's LAN IP on a device, works on emulators too).
#   physical device : http://192.168.1.125:3000
#   Android emulator: http://10.0.2.2:3000
#   production      : https://api.alsaedyoptics.com
EXPO_PUBLIC_API_URL=
